{
  "schema_version": 1,
  "experiment_id": "semantic-neighborhood-transfer-10000",
  "source_experiment": "experiments/semantic-embeddings-10000",
  "seed": 0,
  "neighbors": {
    "k_values": [5, 10, 25, 50, 100],
    "maximum_k": 100,
    "matrix_block_size": 256,
    "paired_similarity_block_size": 64
  },
  "random_pairs": {
    "sample_size": 500000,
    "similarity_block_size": 20000
  },
  "inference": {
    "bootstrap_resamples": 1000,
    "confidence_level": 0.95
  },
  "controls": {
    "coarse_module_path_components": 2,
    "context_matched_random_neighbors": true,
    "matched_context_categories": [
      "same_source_file",
      "same_coarse_module_but_different_file",
      "different_coarse_module"
    ],
    "regression_covariates": [
      "same_coarse_module",
      "same_source_file",
      "absolute_log1p_tactic_count_difference"
    ]
  }
}
